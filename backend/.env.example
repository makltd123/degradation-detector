# --- LLM провайдер ---
# openai (любой OpenAI-compatible endpoint через LLM_BASE_URL) | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_WEAK_MODEL=gpt-3.5-turbo

# Пример с Anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-3-5-haiku-latest
# LLM_WEAK_MODEL=claude-3-5-haiku-latest

# --- пайплайн ---
DD_SOURCE_QUERY_SAMPLE=15
DD_MUTATIONS_PER_QUERY=2
DD_TOP_K_ARTICLES=4
DD_JUDGE_MODE=all                  # all | low_similarity_only
DD_JUDGE_SIMILARITY_THRESHOLD=0.85

# Мультиязычная модель эмбеддингов (важно для русского контента).
# При первом запуске скачается автоматически (~500MB).
DD_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
